// Prisma 6 schema for Neon PostgreSQL.
// `url` uses the pooled connection (runtime), `directUrl` the direct one (migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum PlanStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(EDITOR)
  name         String?
  email        String?   @unique
  planStatus   PlanStatus @default(FREE)
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sites Site[]
  sessions Session[]
  passwordResets PasswordReset[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Site {
  id           String   @id @default(cuid())
  // Optional for now — auth comes in a later phase.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  guestTokenHash String?
  guestExpiresAt DateTime?

  businessName String
  businessType String
  goal         String?
  visualStyle  String?
  builderVersion Int      @default(1)
  templateId     String?
  contentJson    Json?
  designJson     Json?
  replacesSiteId String?  @unique
  replacesSite   Site?    @relation("SiteReplacement", fields: [replacesSiteId], references: [id], onDelete: SetNull)
  replacementDraft Site?  @relation("SiteReplacement")
  location     String?
  phone        String?
  email        String?
  domain       String?
  customDomain String? @unique
  domainVerifiedAt DateTime?
  publicSlug   String   @unique
  language     String?  @default("es")
  status       SiteStatus @default(DRAFT)
  publishedAt  DateTime?
  downloadedAt DateTime?

  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  logoUrl        String? @db.Text
  coverUrl       String? @db.Text

  // Full AI blueprint (site + seo + visualStyle + pages) as returned by the model.
  blueprintJson Json?

  sections  SiteSection[]
  leads     Lead[]
  views     SiteView[]
  revisions SiteRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestTokenHash])
  @@index([guestExpiresAt])
}

model SiteRevision {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reason       String
  snapshotJson Json
  createdAt    DateTime @default(now())

  @@index([siteId, createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

model ProductEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  siteId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([siteId, createdAt])
}

model SiteView {
  siteId  String
  date    String
  views   Int    @default(0)
  site    Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, date])
  @@index([siteId])
}

model SiteSection {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  type         String
  title        String?
  // Flexible content payload for the block (subtitle, body, items, ctas, etc.).
  content      Json?
  order        Int      @default(0)
  isVisible    Boolean  @default(true)
  settingsJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

enum SiteStatus {
  DRAFT
  GENERATED
  PUBLISHED
}
