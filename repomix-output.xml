    assert.ok(widgets.some((widget) => widget.type === "text"), `${template?.id} no tiene texto de apoyo`);
    assert.ok(widgets.some((widget) => widget.type === "button"), `${template?.id} no tiene CTA`);
    return widgets[0]?.type;
  });
