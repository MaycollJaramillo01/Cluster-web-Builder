  try {
    await prisma.siteView.upsert({
      where: { siteId_date: { siteId, date } },
      update: { views: { increment: 1 } },
      create: { siteId, date, views: 1 },
    });
  } catch {
    // Non-blocking: view tracking failures must not break the page render.
  }
}
