};

/**
 * Renders a full site preview from sections + theme using the controlled
 * block renderer. Shared by the editor (editable) and the public preview.
 */
export function SitePreview({
  businessName,
  businessType,
  phone,
  email,
  location,
  publicSlug,
  showBranding,
  logoUrl,
  coverUrl,
  theme,
  visualStyle,
  sections,
  editable = false,
  socialLinks,
}: SitePreviewProps) {
  return (
    <SiteBlockRenderer
      sections={sections}
      theme={theme}
      visualStyle={visualStyle}
      editable={editable}
      site={{ businessName, businessType, phone, email, location, publicSlug, showBranding, logoUrl, coverUrl, socialLinks }}
    />
  );
}
</file>

