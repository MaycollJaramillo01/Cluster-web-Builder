          </div>
          <div className="divide-y border" style={{ backgroundColor: surface.panel, borderColor: `${theme.text}1f`, borderRadius: "var(--site-radius)" }}>
            {items.map((item, i) => (
              <details key={i} data-motion-item className="group px-5 sm:px-7" open={i === 0}>
