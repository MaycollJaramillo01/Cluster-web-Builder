# NVIDIA NIM (primary AI provider — integrate.api.nvidia.com)
# Get your key at: https://build.nvidia.com → Profile → API Keys
NVIDIA_API_KEY=
# Model slug from the NVIDIA Build catalog.
NVIDIA_MODEL=z-ai/glm-5.1

# OpenRouter (fallback — used only when NVIDIA NIM is unavailable or returns an error)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free
# Optional: comma-separated fallback models tried if the primary is rate-limited (429).
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-120b:free,qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free

# Neon PostgreSQL
# DATABASE_URL: pooled connection (used by the app at runtime)
DATABASE_URL=
# DIRECT_URL: direct connection (used by Prisma for migrations / introspection)
DIRECT_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — login credentials (set in Vercel for production)
APP_ACCESS_USER=cluster
APP_ACCESS_PASSWORD=
# Long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 40
SESSION_SECRET=

# ImageKit (AI image generation + media delivery)
# URL endpoint is PUBLIC and required to serve/generate images. Form: https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
# Keys are only needed for uploads (future phase). Keep the private key server-side.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
