# NVIDIA NIM (primary AI provider — integrate.api.nvidia.com)
# Get your key at: https://build.nvidia.com → Profile → API Keys
NVIDIA_API_KEY=
# Model slug from the NVIDIA Build catalog.
NVIDIA_MODEL=z-ai/glm-5.1

# Neon PostgreSQL
# DATABASE_URL: pooled connection (used by the app at runtime)
DATABASE_URL=
# DIRECT_URL: direct connection (used by Prisma for migrations / introspection)
DIRECT_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dominio raíz con DNS wildcard (*.tudominio.com). Sin esto se usa /s/slug.
PUBLIC_ROOT_DOMAIN=

# Plan único M3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Dominios personalizados en Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Bootstrap de administrador (solo para npm run db:create-admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=

# Pexels stock images (server-side only)
PEXELS_API_KEY=
