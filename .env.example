# AI generation (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Neon PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_ROOT_DOMAIN=

# Set only when a trusted self-hosted reverse proxy overwrites client IP headers.
# Vercel is detected automatically and overwrites x-forwarded-for itself.
TRUST_PROXY_HEADERS=false

# Cluster Pro subscription
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Custom domains on Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Transactional email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Cluster

# Administrator bootstrap
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=

# Pexels media (server-side only)
PEXELS_API_KEY=

# Vercel Blob — required to persist uploaded / generated media
# Without this token, data URLs are stripped and sites save without images
BLOB_READ_WRITE_TOKEN=
